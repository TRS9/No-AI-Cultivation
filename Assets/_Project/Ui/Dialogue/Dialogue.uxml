<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Global.uss"/>
    <Style src="Dialogue.uss"/>
    <ui:VisualElement name="DialogueOverlay" style="display: none; position: absolute; width: 100%; height: 100%; justify-content: flex-end; align-items: center;">
        <ui:VisualElement name="DialoguePanel" style="width: 70%; max-width: 800px; margin-bottom: 60px; padding: 20px; background-color: rgba(20, 15, 30, 0.94); border-radius: 8px; border-width: 1px; border-color: rgba(180, 140, 50, 0.5);">
            <!-- NPC Name & Portrait -->
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                <ui:VisualElement name="DialoguePortrait" style="width: 48px; height: 48px; border-radius: 24px; margin-right: 12px; background-color: rgba(100, 80, 150, 0.4);"/>
                <ui:Label text="NPC Name" name="DialogueSpeakerName" style="font-size: 16px; color: rgb(212, 168, 74); -unity-font-style: bold;"/>
            </ui:VisualElement>

            <!-- Dialogue Text -->
            <ui:Label text="" name="DialogueText" style="font-size: 14px; color: rgb(220, 220, 220); white-space: normal; margin-bottom: 16px; min-height: 60px;"/>

            <!-- Choice Buttons -->
            <ui:VisualElement name="DialogueChoices" style="flex-direction: column;"/>

            <!-- Continue Hint -->
            <ui:Label text="[Leertaste / E] Weiter" name="DialogueContinueHint" style="font-size: 11px; color: rgb(120, 120, 120); -unity-text-align: middle-center; margin-top: 8px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
