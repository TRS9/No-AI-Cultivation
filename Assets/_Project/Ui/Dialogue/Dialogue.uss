#DialoguePanel {
}

#DialoguePortrait {
    border-width: 2px;
    border-color: rgba(180, 140, 50, 0.4);
}

#DialogueText {
}

.dialogue-choice-btn {
    height: 32px;
    margin-bottom: 4px;
    background-color: rgba(60, 50, 80, 0.7);
    color: rgb(200, 200, 200);
    border-width: 1px;
    border-color: rgba(180, 140, 50, 0.3);
    border-radius: 4px;
    font-size: 13px;
    -unity-text-align: middle-left;
    padding-left: 12px;
}

.dialogue-choice-btn:hover {
    background-color: rgba(80, 70, 110, 0.9);
    border-color: rgba(212, 168, 74, 0.6);
    color: rgb(212, 168, 74);
}
