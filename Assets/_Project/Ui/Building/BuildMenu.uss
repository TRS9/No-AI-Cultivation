.build-menu {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    background-color: rgba(9, 21, 11, 0.9);
    border-radius: 6px;
    padding: 12px;
    border-width: 2px;
    border-color: rgba(160, 120, 40, 0.4);
    flex-direction: column;
    max-width: 600px;
}

.build-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.build-slot {
    width: 80px;
    height: 90px;
    margin: 4px;
    background-color: rgba(30, 50, 30, 0.6);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(160, 120, 40, 0.3);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.build-slot:hover {
    background-color: rgba(160, 120, 40, 0.2);
    border-color: rgba(212, 168, 74, 0.6);
}

.build-slot__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 4px;
}

.build-slot__label {
    font-size: 10px;
    color: rgb(216, 210, 190);
    -unity-text-align: middle-center;
}
