/* ===== Breakthrough Overlay ===== */
.breakthrough-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

/* ===== Breakthrough Panel ===== */
.breakthrough-panel {
    width: 400px;
    height: auto;
    align-items: stretch;
    position: relative;
}

.breakthrough-title {
    letter-spacing: 5px;
    -unity-text-align: upper-center;
}

.breakthrough-description {
    font-size: 14px;
    color: rgba(184, 200, 168, 0.9);
    -unity-text-align: upper-center;
    margin-top: 12px;
    margin-bottom: 20px;
    white-space: normal;
}

/* ===== Buttons ===== */
.breakthrough-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.breakthrough-confirm-btn {
    padding: 12px 24px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(40, 80, 30, 0.7);
    color: rgb(212, 168, 74);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(180, 140, 50, 0.6);
    margin-right: 12px;
    letter-spacing: 1.5px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.breakthrough-confirm-btn:hover {
    background-color: rgba(60, 110, 40, 0.5);
    border-color: rgba(200, 160, 60, 0.8);
    scale: 1.03;
}

.breakthrough-cancel-btn {
    padding: 12px 24px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(10, 20, 10, 0.7);
    color: rgb(184, 200, 168);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(100, 120, 60, 0.3);
    letter-spacing: 1.5px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.breakthrough-cancel-btn:hover {
    background-color: rgba(40, 70, 30, 0.3);
    border-color: rgba(140, 110, 40, 0.5);
    color: rgb(212, 168, 74);
}

/* ===== Result Message ===== */
.breakthrough-result {
    position: absolute;
    top: 40%;
    left: 50%;
    translate: -50% -50%;
    font-size: 28px;
    -unity-font-style: bold;
    opacity: 0;
    letter-spacing: 3px;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in;
}

.breakthrough-result--success {
    color: rgb(120, 200, 100);
}

.breakthrough-result--failure {
    color: rgb(200, 90, 70);
}
