.dashboard-machine-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 2px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 3px;
}

.dashboard-machine-name {
    font-size: 12px;
    color: rgb(200, 200, 200);
    flex: 1;
}

.dashboard-machine-status {
    font-size: 11px;
    color: rgb(140, 140, 140);
    width: 80px;
    -unity-text-align: middle-right;
}

.dashboard-machine-status--active {
    color: rgb(120, 200, 120);
}

.dashboard-machine-status--idle {
    color: rgb(200, 200, 100);
}

.dashboard-machine-status--unpowered {
    color: rgb(200, 100, 100);
}
