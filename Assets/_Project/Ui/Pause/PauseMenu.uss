.pause-panel {
    width: 300px;
    height: auto;
    align-items: stretch;
    position: absolute;
}

.pause-title {
    letter-spacing: 5px;
    -unity-text-align: upper-center;
}

.menu-btn {
    padding: 12px 18px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(10, 20, 10, 0.7);
    color: rgb(184, 200, 168);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(100, 120, 60, 0.3);
    margin-bottom: 8px;
    letter-spacing: 1.5px;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.menu-btn:hover {
    background-color: rgba(40, 70, 30, 0.3);
    border-color: rgba(140, 110, 40, 0.5);
    color: rgb(212, 168, 74);
}

.volume-section {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(140, 110, 40, 0.3);
}

.volume-header {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(212, 168, 74);
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.volume-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.volume-label {
    width: 60px;
    font-size: 12px;
    color: rgb(184, 200, 168);
}

.volume-slider {
    flex-grow: 1;
}
