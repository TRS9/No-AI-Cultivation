<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="../Global.uss"/>
    <Style src="project://database/Assets/_Project/Ui/Pause/PauseMenu.uss?fileID=7433441132597879392&amp;guid=e1e91b092bf99b540811746d177ae22a&amp;type=3#PauseMenu"/>
    <ui:VisualElement name="PausePanel" class="panel pause-panel" style="display: none;">
        <ui:VisualElement class="panel-header" style="justify-content: center;">
            <ui:Label text="PAUSED" class="panel-title pause-title"/>
        </ui:VisualElement>
        <ui:Button text="RESUME" name="ResumeBtn" class="menu-btn"/>
        <ui:Button text="SAVE" name="SaveBtn" class="menu-btn"/>
        <ui:Button text="LOAD" name="LoadBtn" class="menu-btn"/>
        <ui:Button text="NEW GAME" name="NewGameBtn" class="menu-btn"/>
        <ui:Button text="QUIT" name="QuitBtn" class="menu-btn"/>
        <ui:VisualElement class="volume-section">
            <ui:Label text="AUDIO" class="volume-header"/>
            <ui:VisualElement class="volume-row">
                <ui:Label text="Master" class="volume-label"/>
                <ui:Slider name="MasterVolumeSlider" low-value="0" high-value="1" value="1" class="volume-slider"/>
            </ui:VisualElement>
            <ui:VisualElement class="volume-row">
                <ui:Label text="SFX" class="volume-label"/>
                <ui:Slider name="SFXVolumeSlider" low-value="0" high-value="1" value="1" class="volume-slider"/>
            </ui:VisualElement>
            <ui:VisualElement class="volume-row">
                <ui:Label text="Music" class="volume-label"/>
                <ui:Slider name="MusicVolumeSlider" low-value="0" high-value="1" value="1" class="volume-slider"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
