:root {
}

.panel {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 600px;
    height: 400px;
    background-color: rgba(9, 21, 11, 0.95);
    border-radius: 6px;
    padding: 24px;
    border-width: 2px;
    border-color: rgba(160, 120, 40, 0.4);
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(140, 110, 40, 0.3);
}

.panel-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(212, 168, 74);
    letter-spacing: 4px;
}

.close-btn {
    width: 30px;
    height: 30px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: transparent;
    color: rgba(200, 90, 70, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(160, 70, 40, 0.5);
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.close-btn:hover {
    background-color: rgba(180, 60, 40, 0.15);
    border-color: rgba(200, 80, 50, 0.7);
    color: rgb(220, 100, 80);
}


