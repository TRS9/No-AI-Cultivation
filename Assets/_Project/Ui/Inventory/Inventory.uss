/* ===== Inventory Panel ===== */
.inventory-panel {
    width: 800px;
    height: 480px;
}

.inventory-title {
    letter-spacing: 4px;
}

/* ===== Archive Category Tabs ===== */
.archive-tabs {
    flex-direction: row;
    margin-bottom: 10px;
}

.archive-tab {
    padding: 6px 14px;
    font-size: 13px;
    background-color: rgb(18, 42, 22);
    border-width: 1px;
    border-color: rgba(140, 110, 40, 0.35);
    color: rgb(212, 168, 74);
    border-radius: 3px;
    letter-spacing: 1px;
    margin-right: 8px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.archive-tab:hover {
    background-color: rgba(140, 110, 40, 0.15);
}

.archive-tab--active {
    background-color: rgba(180, 140, 50, 0.25);
    border-color: rgba(200, 160, 60, 0.5);
    color: rgb(255, 216, 128);
}

/* ===== Content Area: Grid + Detail ===== */
.inventory-content {
    flex-direction: row;
    flex-grow: 1;
}

/* ===== Shelf Grid ===== */
.inventory-grid {
    flex-grow: 1;
}

.inventory-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* ===== Individual Shelf Slot ===== */
.shelf-slot {
    width: 100px;
    height: 100px;
    margin: 6px;
    background-color: rgba(10, 30, 15, 0.6);
    border-width: 1px;
    border-color: rgba(70, 90, 50, 0.3);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.shelf-slot:hover {
    background-color: rgba(40, 80, 30, 0.25);
    border-color: rgba(140, 110, 40, 0.4);
}

.shelf-slot--selected {
    border-color: rgb(212, 168, 74);
}

.shelf-slot__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
}

.shelf-slot__qty {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: rgba(20, 50, 20, 0.8);
    border-width: 1px;
    border-color: rgba(140, 110, 40, 0.35);
    border-radius: 3px;
    padding: 1px 4px;
    font-size: 11px;
    color: rgb(212, 168, 74);
    -unity-font-style: bold;
}

.shelf-slot__platform {
    position: absolute;
    bottom: 6px;
    left: 10%;
    width: 80%;
    height: 4px;
    background-color: rgb(26, 58, 34);
    border-width: 1px;
    border-color: rgba(100, 120, 60, 0.4);
    border-radius: 2px;
}

/* ===== Item Detail Parchment Panel ===== */
.item-detail-panel {
    width: 240px;
    margin-left: 16px;
    padding: 16px;
    background-color: rgb(226, 209, 166);
    border-width: 1px;
    border-color: rgb(192, 176, 128);
    border-radius: 4px;
}

.detail-title {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(106, 90, 58);
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 80, 40, 0.3);
}

.detail-divider {
    height: 1px;
    background-color: rgba(100, 80, 40, 0.3);
    margin-bottom: 8px;
}

.detail-field {
    flex-direction: row;
    margin-bottom: 4px;
}

.detail-label {
    width: 80px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(138, 122, 90);
    letter-spacing: 0.5px;
}

.detail-value {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(74, 58, 26);
}

.detail-description {
    font-size: 12px;
    color: rgb(74, 58, 26);
    margin-top: 8px;
    white-space: normal;
}

.detail-use-btn {
    margin-top: 12px;
    padding: 8px;
    background-color: rgb(192, 176, 128);
    border-width: 1px;
    border-color: rgb(154, 138, 106);
    border-radius: 3px;
    color: rgb(74, 58, 26);
    font-size: 13px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.detail-use-btn:hover {
    background-color: rgb(208, 192, 144);
}
